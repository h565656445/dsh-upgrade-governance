{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hermes-harness/schemas/hermes.upgrade_audit/0.2",
  "title": "Hermes adapter upgrade audit 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "audited_at", "passed", "project_registry_sha256", "generated_registry_sha256", "matrix_sha256", "artifact_hash_matches", "artifact_hash_expected", "gate_checks_passed", "project_bindings", "schema_registry_entries_verified", "g4_overridable", "g5_overridable", "checks", "non_authoritative"],
  "properties": {
    "schema_identity": { "$ref": "#/$defs/schema_identity" },
    "audited_at": { "type": "string", "format": "date-time" },
    "passed": { "type": "boolean" },
    "project_registry_sha256": { "$ref": "#/$defs/sha256" },
    "generated_registry_sha256": { "$ref": "#/$defs/sha256" },
    "matrix_sha256": { "$ref": "#/$defs/sha256" },
    "artifact_hash_matches": { "type": "integer", "minimum": 0, "maximum": 2 },
    "artifact_hash_expected": { "const": 2 },
    "gate_checks_passed": { "type": "integer", "minimum": 0, "maximum": 8 },
    "project_bindings": { "type": "integer", "minimum": 0, "maximum": 4 },
    "schema_registry_entries_verified": { "type": "integer", "minimum": 0 },
    "g4_overridable": { "const": false },
    "g5_overridable": { "const": false },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "passed", "evidence"],
        "properties": {
          "check_id": { "type": "string", "pattern": "^[A-Z0-9_-]{2,64}$" },
          "passed": { "type": "boolean" },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "non_authoritative": { "const": true }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "schema_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "version", "sha256"],
      "properties": {
        "schema_id": { "const": "hermes.upgrade_audit" },
        "version": { "const": "0.2" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
